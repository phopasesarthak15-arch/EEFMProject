# ========================================================
# Student Expense Optimizer - Environment Configuration
# ========================================================

# Database Connection (Optional)
# - Local default: sqlite:///./expense_optimizer.db
# - Vercel serverless default: sqlite:////tmp/expense_optimizer.db (auto-seeded)
# - Production Cloud DB (PostgreSQL / Supabase / Neon):
# DATABASE_URL=postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require

# Frontend API Base URL (Optional)
# - Defaults to same-origin "/api" in production & development Vite proxy
# - Set only if hosting backend on an external custom domain:
# VITE_API_URL=https://your-api-domain.com/api

# Application Port (Development only, default: 8000)
# PORT=8000
